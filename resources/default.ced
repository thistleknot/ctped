//This is the default project file
//Do not save over this or open it as a project

//Version
0.3

PRJ_		//Prefix
Project Title	//Title
//(Comment & delimiter charachters no longer stored in project file
// they should now be set in the structure file)
//#		//Comment charachter in data files
//%032%009	//Delimiter charachters in data files
		// (use %nnn for ASCII ref)
//:		//Break on right quasi-delimiter
//}{		//Break on left quasi-delimiter

//Name and location of three unique files

PRJ_Gamefile.txt	%cdefault\gamedata\
//Newsprite used to be defined here, now it's down below...
//PRJ_Newsprite.txt	%cdefault\gamedata\
PRJ_Great_Library.txt	%c%l\gamedata\

//Names and locations of all the other data files and their associated structure files
// null\ for the structure file path indicates that no structure file exists,
//       but the structure file name must still be unique
// In the paths:
//  %s refers to the structure file path
//  %c refers to the ctp_data path
//  %l refers to the language

// The last three columns are:
//  Whether this file is editable by default
//  Whether this file is listed after the name in the *_gamefile.txt
//  Duplication - if this file is duplicated, how many copies, otherwise 0

%s	strings.ces		%c%l\gamedata\		strings.txt		f	f	0
%s	sounds.ces		%cdefault\gamedata\	sounds.txt		f	f	0
