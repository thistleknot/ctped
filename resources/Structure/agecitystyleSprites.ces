0.3 //Version number

1 //Format

f //Whether this has a number at the top (num of fields)
f //Whether this has a tree structure
f //Whether this file references GL entries
f //Whether this file has entries in gl_str.txt
f //Whether this file is the GL icon file
f //Whether this structure file describes formatting of fields
  // (i.e. whether it has the LBF and LAF columns below)

//Name			Comp	PByDef	AMult	NumArgs
	//Type		DefaultValue	Comment
Type			t	t	f	1
	0		0		Wheather the city is of type land (0) or type sea (1)
MinSize			t	t	f	1
	0		0		Minimum size of city size at this the specified sprite should be used
MaxSize			t	t	f	1
	0		6		Maximum size of city size at this the specified sprite should be used
Sprite			t	t	f	1
	0		1		Sprite number, must be a valid sprite from ..\ctp2_data\default\graphics\sprites folder
@ //End of fields

